# Croma x Zopper Feedback Form — environment variables
# Local development: copy to .env.local (git-ignored). Production: the host's server-side environment-variable settings (hosting is decided separately).
# NEVER commit real values. All three are SERVER-SIDE ONLY (used by /api/feedback/*); none may reach the browser,
# so none of them may be prefixed VITE_ / NEXT_PUBLIC_.

# REQUIRED. Project URL of the EXISTING Supabase project that holds croma_stores and croma_feedback_submissions.
# Supabase dashboard -> Project Settings -> API -> Project URL   (form: https://<project-ref>.supabase.co)
FORM_SUPABASE_URL=

# REQUIRED. Server-only secret key for that same project.
# Supabase dashboard -> Project Settings -> API Keys -> "Secret key" (starts with sb_secret_...),
# or the legacy "service_role" key. It bypasses Row Level Security, so keep it out of the repo and the client.
FORM_SUPABASE_SERVICE_ROLE_KEY=

# RECOMMENDED. Any long random string used to salt the hash of visitor IPs for rate limiting
# (the raw IP is never stored). If omitted the code falls back to SESSION_SECRET (not used in this app)
# and then to a fixed built-in string, so set this explicitly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FEEDBACK_IP_SALT=

# --- Only for the one-off store import script (npm run stores:seed); it reads the same two variables above. ---
# Not needed by the running website:  SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, APP_URL,
# KV_REST_API_URL, KV_REST_API_TOKEN (Google login + Upstash Redis belong to the Master App only).
